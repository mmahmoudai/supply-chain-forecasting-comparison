# --- Python ---
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/

# --- Virtual environments ---
.venv/
venv/
env/
.env

# --- Trained models / serialized binaries (regenerated by running the pipeline) ---
*.pkl
*.pt
*.cbm
*.joblib
outputs/models/
catboost_info/

# --- Generated outputs: only the headline results file is tracked ---
# Everything else under outputs/ (figures, logs, reports, per-model configs,
# tables, summaries) is regenerated by running the pipeline.
outputs/*
!outputs/results/
outputs/results/*
!outputs/results/all_cases_results.csv

# --- Generated figure images (regenerated by paper_figures/generate_figures.py) ---
paper_figures/*.pdf
paper_figures/*.png

# --- Datasets (not redistributed; obtain via the Data Availability statement) ---
# See new_dataset/README.md for the exact files and folder layout the code expects.
new_dataset/**/*.csv
new_dataset/**/*.xlsx
new_dataset/**/*.zip

# --- Local experiment output trees not part of the release ---
output2/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
